RewriteEngine On

# Redirect to HTTPS (if applicable)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Deny access to sensitive files
<FilesMatch "\.(sql|md|gitignore|log|env|ini)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to config and includes directories
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^sql/ - [F,L]
</IfModule>

# Deny access to debug/diagnostic/test tools - not for production use
<FilesMatch "^(debug|diagnostic|content-diagnostic|waf-debug|visibility-test|test-email|test-form-debug|test-form-submission|test-startup|test_basepath|login-test|page-loading-diagnostic|blank-page-fixer)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
